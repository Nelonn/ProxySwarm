{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxySwarm",
  "version": "0.1.0",
  "identifier": "com.proxyswarm.desktop",
  "build": {
    "beforeDevCommand": "trunk serve --port 1420",
    "beforeBuildCommand": "trunk build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProxySwarm",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
